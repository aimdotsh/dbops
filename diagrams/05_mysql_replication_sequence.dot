digraph G {
 graph [bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.48, splines=ortho];
 node [shape=box, style="rounded,filled", fillcolor="#F7F9FC", color="#3763A3", fontname="DejaVu Sans", fontsize=9, width=1.75, height=0.55];

 a[label="1. 选择 Primary / Replica"]; b[label="2. 兼容性 PreCheck\n版本/GTID/binlog/server_id"]; c[label="3. 创建复制账号"]; d[label="4. XtraBackup/克隆\n初始化 Replica"]; e[label="5. Prepare + Restore\n权限修复"];
 f[label="6. 配置 Source\nGTID 自动定位"]; g[label="7. START REPLICA"]; h[label="8. 验证 IO/SQL\nGTID + Lag"]; i[label="9. 登记 Topology\n启用告警", fillcolor="#EAF9F1"];

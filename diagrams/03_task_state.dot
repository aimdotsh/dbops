digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.28, ranksep=0.5, fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fillcolor="#F7F9FC", color="#5B6B7A", fontname="DejaVu Sans", fontsize=10];
  edge [color="#637083", arrowsize=0.65];
  pending -> queued -> running -> success;
  running -> failed; running -> cancelled; running -> timeout; running -> paused; paused -> queued;
  running -> interrupted [label="server/agent restart"];
  interrupted -> queued [label="safe retry"];
  interrupted -> failed [label="verify failed"];
  interrupted -> manual [label="R3/R4 unknown"];
  success [fillcolor="#EAF7EE"]; failed [fillcolor="#FDECEC"]; interrupted [fillcolor="#FFF4DB"];
}